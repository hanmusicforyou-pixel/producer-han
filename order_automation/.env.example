# ──────────────────────────────────────────────────────────────
# 영암부부농원 발주 자동화 설정  (이 파일을 .env 로 복사해서 값 채우기)
# ──────────────────────────────────────────────────────────────

# [필수] 네이버 계정 (아이디 또는 전체 메일주소) / 비밀번호
#   - 네이버 메일 > 환경설정 > POP3/IMAP 설정 > IMAP/SMTP 사용 "사용함"
#   - 2단계 인증을 켜고 "애플리케이션 비밀번호"를 발급받아 아래에 넣기 (평소 비밀번호는 거부됨)
NAVER_ID=k333896
NAVER_APP_PASSWORD=여기에_네이버_비밀번호_또는_앱비밀번호

# [필수] 내 정보 (메일 본문/안내문 서명에 들어감)
MY_NAME=담당자 이름
MY_PHONE=010-0000-0000

# 발주처 (박경원님)
SUPPLIER_EMAIL=kwpark462@naver.com
SUPPLIER_NAME=박경원

# 요약 메일을 받을 내 주소 (비우면 네이버 주소로 보냄)
NOTIFY_EMAIL=

# 제목 키워드 : "(N)월 (N)일 영암부부농원 발주서"
SUBJECT_KEYWORD=영암부부농원 발주서

# 시간 설정 (한국시간)
COLLECT_TIME=10:00           # 업체 발주서 접수 마감 + 통합발주 발송 시각 (접수 0건이면 이후 30분마다 재확인)
REPLY_CHECK_INTERVAL_MIN=30  # PC 스케줄러에서 회신 확인 주기(분). GitHub Actions 는 워크플로우 cron 이 결정
LOOKBACK_DAYS=3              # 며칠 전 메일까지 뒤져볼지 (전날 저녁 발송분 포함)

# 운영 기간 : 이 날짜가 지나면 자동으로 아무 것도 하지 않음
END_DATE=2026-10-30

# 2단계 결과 발송 대상
SEND_TO_VENDORS=true         # 각 업체에 자기 몫 엑셀 + 안내문 발송
VENDOR_MAIL_CC_ME=false      # 업체 발송 메일에 나를 CC로 넣기
